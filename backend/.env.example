# ==============================================================================
# KRISHI MITRA BACKEND ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================

# Application Environment (development | production)
ENVIRONMENT=development

# Offline Demo Mode: true keeps fallback heuristics active if cloud keys fail or are absent
DEMO_MODE=true

# Server Host and Port
HOST=0.0.0.0
PORT=8000

# Google Gemini API Key (Official Google Gen AI SDK)
# Obtain from: https://aistudio.google.com/
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Sarvam AI API Key (Official Sarvam AI Platform)
# Obtain from: https://dashboard.sarvam.ai/
SARVAM_API_KEY=
SARVAM_BASE_URL=https://api.sarvam.ai
SARVAM_STT_MODEL=saaras:v2
SARVAM_TTS_MODEL=bulbul:v1
SARVAM_TTS_SPEAKER=meera
AUTO_SYNTHESIZE_SPEECH=true

# Allowed CORS Origins (comma-separated strings or JSON array)
# In production, replace with your Vercel deployment URL
CORS_ORIGINS=https://krishi-mitra.vercel.app,http://localhost:5173,http://127.0.0.1:5173

# Audio Upload Constraint
MAX_AUDIO_UPLOAD_SIZE_MB=15
